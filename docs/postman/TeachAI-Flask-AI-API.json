		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set Flask API base URL if not already set",
					"if (!pm.environment.get('flask_base_url')) {",
					"    pm.environment.set('flask_base_url', 'http://localhost:8000');",
					"}",
					"",
					"// Add timestamp to requests",
					"pm.environment.set('timestamp', new Date().toISOString());",
					"",
					"// Set content type for requests",
					"pm.request.headers.add({",
					"    key: 'Accept',",
					"    value: 'application/json'",
					"});"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global response time test (Flask may be slower due to AI processing)",
					"pm.test('Response time is less than 30000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(30000);",
					"});",
					"",
					"// Global content type test",
					"if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
					"    pm.test('Response is valid JSON', function () {",
					"        pm.response.to.be.json;",
					"    });",
					"}",
					"",
					"// Check for common error patterns",
					"if (pm.response.code >= 400) {",
					"    pm.test('Error response includes message', function () {",
					"        const response = pm.response.json();",
					"        pm.expect(response).to.have.property('error');",
					"    });",
					"}"
				]
			}
		}
